# Server Port (Render sets this automatically, default 5000)
PORT=5000

# Environment mode (production on Render, development locally)
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@sidkarv.csyxefl.mongodb.net/unisol?retryWrites=true&w=majority&appName=sidkarv

# Secret key used for signing JWT tokens
JWT_SECRET=unispark_cms_super_secret_jwt_key_2026_secure

# Allowed Frontend URLs (comma-separated for multiple origins, e.g. Vercel domain + localhost)
CLIENT_URL=https://your-frontend-project.vercel.app,http://localhost:5173

# Optional: Cloudinary configuration for persistent cloud media uploads on serverless/ephemeral hosts
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
